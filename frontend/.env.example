# Copy to `.env` for local dev. Never commit `.env`.
# Empty = same-origin (Vite proxy in dev, vercel.json rewrite in prod).
VITE_API_URL=
# Absolute site root for sitemap.xml / RSS / canonical links.
# In production set this to the Vercel URL (or custom domain):
# SITE_URL=https://<project>.vercel.app/
SITE_URL=
