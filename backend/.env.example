# Copy to `.env` for local dev. Never commit `.env`.
# Port the API listens on (must match frontend/vite.config.ts proxy).
PORT=3000
# Log filter (tracing_subscriber EnvFilter syntax).
RUST_LOG=info
# Database connection string. Defaults to local SQLite when unset/blank
# (file is created on first connect thanks to `mode=rwc`).
# Point at Postgres when you need it:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app
# Set DATABASE_URL=none to run without a database (notes routes return 503).
DATABASE_URL=sqlite://./dev.db?mode=rwc
# Comma-separated browser origins allowed to call the API.
# Blank/unset = permissive (local dev). In production set the Vercel URL:
# ALLOWED_ORIGINS=https://<project>.vercel.app
ALLOWED_ORIGINS=
# Alias for a single production origin:
# FRONTEND_URL=https://<project>.vercel.app
